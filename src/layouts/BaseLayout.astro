---
import '../styles/global.css';
const { title, description = 'Un recorrido por tres destinos imperdibles de Colombia.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Colombia por Descubrir</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base}>COLOMBIA <span>POR DESCUBRIR</span></a>
        <nav aria-label="Navegación principal">
          <a href={base}>Inicio</a>
          <a href={`${base}#destinos`}>Destinos</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner"><span>Colombia por Descubrir</span><span>Blog académico · Desarrollo de Aplicaciones en Red</span></div>
    </footer>
  </body>
</html>
